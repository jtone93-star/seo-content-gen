# Local PostgreSQL (default after scripts/install-postgres.ps1):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/content_generator"

# Supabase cloud (for Vercel):
# Transaction pooler (app runtime on Vercel) — port 6543:
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct / session (migrations) — port 5432:
# DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"
# Or direct DB host:
# DIRECT_URL="postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres"

# 32-byte base64 key used to encrypt BYO API keys at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=""

# Single-user login gate. Leave empty to disable (open app, good for local dev).
# Set a strong value in production (e.g. on Vercel) to require a password.
APP_PASSWORD=""

# Google OAuth for Analytics 4 + Search Console strategy data.
# Create a Web application OAuth client in Google Cloud and enable:
# Google Analytics Data API, Google Analytics Admin API, Search Console API.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Local default. Production should be your Vercel URL + /api/google/oauth/callback.
# Desktop Windows app forces: http://127.0.0.1:47821/api/google/oauth/callback
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/oauth/callback"
