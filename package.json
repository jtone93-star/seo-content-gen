{
  "name": "content-generator-tool",
  "version": "0.1.0",
  "private": true,
  "main": "desktop/dist/main.js",
  "scripts": {
    "dev": "next dev",
    "worker": "tsx src/worker/run-worker.ts",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma migrate dev && npm run db:seed",
    "db:start": "powershell -ExecutionPolicy Bypass -File ./scripts/start-postgres.ps1",
    "postinstall": "prisma generate",
    "desktop:main": "node desktop/build-main.mjs",
    "desktop:dev": "node desktop/build-main.mjs && electron .",
    "desktop:build": "npm run build && node desktop/build-main.mjs && node desktop/prepare-standalone.mjs",
    "desktop:dist": "npm run desktop:build && electron-builder --win --x64 --config electron-builder.config.js"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "exceljs": "^4.4.0",
    "google-auth-library": "^10.9.0",
    "googleapis": "^173.0.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.1",
    "typescript": "^5"
  }
}
